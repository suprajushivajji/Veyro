# RecoverOS Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────
POSTGRES_USER=recoveros
POSTGRES_PASSWORD=recoveros_dev_2024
POSTGRES_DB=recoveros
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recoveros:recoveros_dev_2024@localhost:5432/recoveros

# ─── API ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_DEBUG=true

# ─── LLM Provider (Phase 10) ───────────────────────────
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gemini-2.0-flash

# ─── Razorpay (Phase 12) ───────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx

# ─── Observability ─────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
